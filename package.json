{
  "name": "@wenker-ai/wenker-router",
  "version": "2.1.17",
  "description": "WENKER Router - Open Source Local AI Proxy Gateway supporting 180+ providers and WENKER Cloud",
  "main": "server/index.js",
  "bin": {
    "wenker": "bin/wenker.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "bin/",
    "server/",
    "client/dist/",
    "system-prompts/",
    "web/",
    "!web/assets/banner.png",
    "!web/assets/icon.png",
    "!web/assets/chữ thường.ttf",
    "!web/assets/chữ đậm hoặc lớn.ttf",
    "start.bat",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:ts": "node --loader ts-node/esm server/index.ts",
    "dev": "node server/index.js",
    "dev:ts": "node --loader ts-node/esm server/index.ts",
    "build": "npx ts-node scripts/build.ts",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build && npm run build:client",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "pack:dry": "npm pack --dry-run",
    "web": "node scripts/serve-web.js",
    "lint": "eslint server/**/*.ts server/**/*.js scripts/**/*.js bin/*.js",
    "lint:fix": "eslint --fix server/**/*.ts server/**/*.js scripts/**/*.js bin/*.js",
    "format": "prettier --write \"server/**/*.ts\" \"server/**/*.js\" \"scripts/**/*.js\" \"bin/*.js\" \"web/assets/*.js\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"server/**/*.js\" \"scripts/**/*.js\" \"bin/*.js\" \"web/assets/*.js\"",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.js",
    "test:mocha": "npx mocha tests/**/*.test.js --timeout 10000",
    "test:watch": "npx mocha tests/**/*.test.js --watch --timeout 10000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WENKER-AI/wenker-router.git"
  },
  "homepage": "https://github.com/WENKER-AI/wenker-router#readme",
  "bugs": {
    "url": "https://github.com/WENKER-AI/wenker-router/issues"
  },
  "keywords": [
    "ai",
    "router",
    "gateway",
    "proxy",
    "openai",
    "anthropic",
    "claude-code",
    "wenker",
    "deepseek",
    "ollama"
  ],
  "author": "arist999",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "prom-client": "^15.1.3",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "mocha": "^12.0.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
