{
  "name": "wenker-router",
  "version": "2.1.13",
  "type": "module",
  "description": "WENKER Router - Open Source Local AI Proxy Gateway supporting 180+ providers and WENKER Cloud",
  "main": "server/index.js",
  "bin": {
    "wenker": "bin/wenker.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "bin/",
    "server/",
    "client/dist/",
    "system-prompts/",
    "web/",
    "!web/assets/banner.png",
    "!web/assets/icon.png",
    "!web/assets/chữ thường.ttf",
    "!web/assets/chữ đậm hoặc lớn.ttf",
    "start.bat",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:client": "cd client && npm run build",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "pack:dry": "npm pack --dry-run",
    "web": "node scripts/serve-web.js",
    "lint": "eslint server/**/*.js scripts/**/*.js bin/*.js",
    "lint:fix": "eslint --fix server/**/*.js scripts/**/*.js bin/*.js",
    "format": "prettier --write \"server/**/*.js\" \"scripts/**/*.js\" \"bin/*.js\" \"web/assets/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\" \"scripts/**/*.js\" \"bin/*.js\" \"web/assets/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WENKER-AI/wenker-router.git"
  },
  "homepage": "https://github.com/WENKER-AI/wenker-router#readme",
  "bugs": {
    "url": "https://github.com/WENKER-AI/wenker-router/issues"
  },
  "keywords": [
    "ai",
    "router",
    "gateway",
    "proxy",
    "openai",
    "anthropic",
    "claude-code",
    "wenker",
    "deepseek",
    "ollama"
  ],
  "author": "arist999",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "mocha": "^12.0.1",
    "prettier": "^3.3.3"
  }
}
